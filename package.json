{
  "name": "wildhack-firewatch",
  "version": "1.0.0",
  "description": "Forest Fire Early Detection & Response system for Tadoba Andhari Tiger Reserve, Maharashtra",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "simulate": "node simulator/simulate.js",
    "simulate:render": "node simulator/simulate.js --render",
    "fire": "node simulator/trigger.js fire",
    "fire:render": "node simulator/trigger.js fire --render",
    "warn": "node simulator/trigger.js warn",
    "warn:render": "node simulator/trigger.js warn --render",
    "clear": "node simulator/trigger.js clear",
    "clear:render": "node simulator/trigger.js clear --render",
    "kill": "node simulator/trigger.js kill",
    "kill:render": "node simulator/trigger.js kill --render",
    "revive": "node simulator/trigger.js revive",
    "revive:render": "node simulator/trigger.js revive --render"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "wildfire",
    "forest-fire",
    "iot",
    "realtime",
    "tadoba",
    "sse",
    "leaflet"
  ],
  "author": "WildHack Team",
  "license": "MIT"
}
